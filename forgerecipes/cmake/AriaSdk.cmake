# The application selects SDK features; the external recipe owns their builds.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PackageLocation.cmake")

function(forgerecipes_sdk)
    cmake_parse_arguments(SDK "OFFLINE" "FILE;SOURCE;CONFIGURATION;PREFIXES;QT;HTTP;TLS;JNI;APPKIT;UIKIT;SHARED"
        "SOURCE_OVERRIDES;EXTRA_PACKAGES" ${ARGN})
    if(NOT SDK_FILE OR SDK_UNPARSED_ARGUMENTS OR SDK_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "forgerecipes_sdk requires FILE and explicit feature values")
    endif()
    if(NOT ForgeDeps_PYTHON_EXECUTABLE)
        if(FORGEDEPS_PYTHON_EXECUTABLE)
            set(ForgeDeps_PYTHON_EXECUTABLE "${FORGEDEPS_PYTHON_EXECUTABLE}")
        else()
            find_package(Python3 3.14 REQUIRED COMPONENTS Interpreter)
            set(ForgeDeps_PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
        endif()
    endif()
    execute_process(COMMAND "${ForgeDeps_PYTHON_EXECUTABLE}" -m forgedeps cmake-dir
        RESULT_VARIABLE _status OUTPUT_VARIABLE _directory ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Install requirements-build.txt with ${ForgeDeps_PYTHON_EXECUTABLE}: ${_error}")
    endif()
    include("${_directory}/ForgeDeps.cmake")
    set(_features)
    foreach(_feature HTTP TLS QT JNI APPKIT UIKIT SHARED)
        string(TOLOWER "${_feature}" _name)
        if(SDK_${_feature})
            list(APPEND _features "${_name}=True")
        else()
            list(APPEND _features "${_name}=False")
        endif()
    endforeach()
    string(JOIN ", " _arguments ${_features})
    set(_config "${CMAKE_CURRENT_BINARY_DIR}/aria-sdk-project.py")
    set(_options)
    if(SDK_QT)
        find_package(Qt6 REQUIRED COMPONENTS Core Widgets)
        set(_qt_inputs "${Qt6_DIR}")
        foreach(_target Qt6::Core Qt6::Gui Qt6::Widgets)
            foreach(_property IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG IMPORTED_IMPLIB_RELEASE IMPORTED_IMPLIB_DEBUG)
                get_target_property(_location ${_target} ${_property})
                if(_location AND EXISTS "${_location}")
                    list(APPEND _qt_inputs "${_location}")
                endif()
            endforeach()
            get_target_property(_includes ${_target} INTERFACE_INCLUDE_DIRECTORIES)
            foreach(_include IN LISTS _includes)
                if(EXISTS "${_include}")
                    list(APPEND _qt_inputs "${_include}")
                endif()
            endforeach()
        endforeach()
        list(REMOVE_DUPLICATES _qt_inputs)
        execute_process(COMMAND "${ForgeDeps_PYTHON_EXECUTABLE}" -m forgerecipes.sdk_identity ${_qt_inputs}
            RESULT_VARIABLE _identity_status OUTPUT_VARIABLE _qt_identity ERROR_VARIABLE _identity_error
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT _identity_status EQUAL 0)
            message(FATAL_ERROR "Qt SDK identity failed: ${_identity_error}")
        endif()
        list(APPEND _options "-DQt6_DIR=${Qt6_DIR}" "-DARIA_SDK_QT_VERSION=${Qt6_VERSION}"
            "-DARIA_SDK_QT_IDENTITY=${_qt_identity}")
    endif()
    set(_option_literals)
    foreach(_option IN LISTS _options)
        string(REPLACE "\\" "\\\\" _option "${_option}")
        string(REPLACE "\"" "\\\"" _option "${_option}")
        list(APPEND _option_literals "\"${_option}\"")
    endforeach()
    string(JOIN ", " _option_arguments ${_option_literals})
    set(_package_literals)
    foreach(_package IN LISTS SDK_EXTRA_PACKAGES)
        if(NOT _package MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Invalid extra package name: ${_package}")
        endif()
        list(APPEND _package_literals "'${_package}'")
    endforeach()
    string(JOIN ", " _package_arguments ${_package_literals})
    file(CONFIGURE OUTPUT "${_config}" CONTENT
        "from forgerecipes import make_sdk_config\nCONFIG = make_sdk_config(${_arguments}, aria_options=[${_option_arguments}], extra_packages=[${_package_arguments}])\n" @ONLY)
    set(_configuration "${SDK_CONFIGURATION}")
    if(NOT _configuration)
        set(_configuration "${CMAKE_BUILD_TYPE}")
    endif()
    if(NOT _configuration)
        set(_configuration "Release")
    endif()
    set(_extra)
    if(SDK_OFFLINE OR ARIA_DEPENDENCIES_OFFLINE)
        list(APPEND _extra OFFLINE)
    endif()
    set(_sources ${SDK_SOURCE_OVERRIDES} ${ARIA_SDK_SOURCE_OVERRIDES})
    if(SDK_SOURCE)
        list(APPEND _sources "aria=${SDK_SOURCE}")
    endif()
    string(JOIN "," _selected aria ${SDK_EXTRA_PACKAGES})
    # An empty multi-value keyword counts as a keyword without values, so only
    # pass SOURCE_OVERRIDES when an override exists.
    if(_sources)
        list(PREPEND _sources SOURCE_OVERRIDES)
    endif()
    forgedeps_environment(FILE "${SDK_FILE}" PROJECT_CONFIG "${_config}" ONLY "${_selected}"
        CONFIGURATION "${_configuration}"
        ${_sources} PREFIXES _prefixes ${_extra})
    set(CMAKE_PREFIX_PATH "${CMAKE_PREFIX_PATH}" PARENT_SCOPE)
    set(FORGEDEPS_ENVIRONMENT "${FORGEDEPS_ENVIRONMENT}" PARENT_SCOPE)
    if(SDK_PREFIXES)
        set(${SDK_PREFIXES} "${_prefixes}" PARENT_SCOPE)
    endif()
endfunction()
